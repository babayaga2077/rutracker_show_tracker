# --- Telegram ---
# Get a token from @BotFather
TELEGRAM_BOT_TOKEN=

# Only these Telegram user IDs may control the bot (comma-separated).
# Send /start to the bot and it will tell you your ID if you're not allowed yet.
ALLOWED_USER_IDS=

# --- RuTracker ---
# The bot reads RuTracker's official read-only JSON API. No account, no login,
# no cookies, and no Cloudflare challenge. Mirrors:
#   https://api.rutracker.org/v1  |  https://api.t-ru.org/v1
RUTRACKER_API_BASE=https://api.rutracker.org/v1

# Only used to build the clickable topic links in Telegram messages.
#   https://rutracker.org  |  https://rutracker.net  |  https://rutracker.nl
RUTRACKER_BASE=https://rutracker.org

# How often to check every tracked topic, in minutes.
# All tracked topics go out in one batched request, so this can be low.
CHECK_INTERVAL_MINUTES=60
