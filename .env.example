# --- Telegram ---
# Get a token from @BotFather
TELEGRAM_BOT_TOKEN=

# Only these Telegram user IDs may control the bot (comma-separated).
# Send /start to the bot and it will tell you your ID if you're not allowed yet.
ALLOWED_USER_IDS=

# --- RuTracker ---
# Which mirror to scrape. Also used for the links in Telegram messages.
#   https://rutracker.org  |  https://rutracker.net  |  https://rutracker.nl
RUTRACKER_BASE=https://rutracker.org

# --- Cloudflare bypass (REQUIRED) ---
# rutracker.org serves a JS challenge ("Just a moment...") to everything that
# isn't a real browser. FlareSolverr clears it; start it with:
#   docker compose up -d
# Leave empty only if you're testing whether curl_cffi alone gets through.
FLARESOLVERR_URL=http://localhost:8191/v1

# How often to check every tracked topic, in minutes, and how long to pause
# between individual topic page loads. Each check is now a real page load, so
# don't set these aggressively low — that invites a harder challenge.
CHECK_INTERVAL_MINUTES=120
FETCH_DELAY_SECONDS=5
