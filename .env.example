# --- Telegram ---
# Get a token from @BotFather
TELEGRAM_BOT_TOKEN=

# Only these Telegram user IDs may control the bot (comma-separated).
# Send /start to the bot and it will tell you your ID if you're not allowed yet.
ALLOWED_USER_IDS=

# --- RuTracker credentials (OPTIONAL) ---
# Not required: the bot detects updates from the post edit date + episode range,
# which are visible to guests. Fill these in only if you also want the torrent's
# "Зарегистрирован" (registered) date used as an extra signal.
RUTRACKER_USERNAME=
RUTRACKER_PASSWORD=

# Base mirror to use. rutracker.org is often blocked; these mirrors usually work:
#   https://rutracker.org  |  https://rutracker.net  |  https://rutracker.nl
RUTRACKER_BASE=https://rutracker.org

# How often to check every tracked topic, in minutes.
CHECK_INTERVAL_MINUTES=120
